---
import Base from "../layouts/Base.astro";
import { company } from "../site";
---
<Base title="Impressum" description="Impressum der THE CRU GmbH, Rotkreuz.">
  <article class="cru-page" data-szene="Impressum">
    <h1>Impressum</h1>
    <address>
      {company.name}<br />
      {company.street}<br />
      {company.zip} {company.city}<br />
      {company.country}
    </address>
    <p>
      <a href={`mailto:${company.email}`}>{company.email}</a><br />
      <a href={company.phoneHref}>{company.phone}</a>
    </p>
    <h2>Handelsregister</h2>
    <p>UID {company.uid}<br />MWST {company.vat}</p>
    <h2>Vertretungsberechtigte Personen</h2>
    <p class="cru-placeholder">[VERTRETUNGSBERECHTIGTE_PERSONEN]</p>
  </article>
</Base>
