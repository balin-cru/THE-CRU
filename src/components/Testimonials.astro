---
import VideoFrame from "./VideoFrame.astro";
// Kundenstimmen: nur wörtliche, schriftlich freigegebene Zitate. Noch keine vorhanden.
---
<section class="cru-section cru-voices cru-voice-media" aria-labelledby="stimmen-titel">
  <div class="cru-voices__head">
    <div><h2 class="cru-voices__title" id="stimmen-titel">Was Kunden über uns sagen</h2></div>
  </div>
  <div class="cru-voice-media__row">
    <figure class="cru-voice">
      <span class="cru-voice__mark" aria-hidden="true">«</span>
      <div>
        <blockquote class="cru-voice__quote"><p style="margin:0" class="cru-placeholder">[ZITAT_KUNDE_1, wörtlich und schriftlich freigegeben]</p></blockquote>
        <figcaption class="cru-voice__by">
          <span class="cru-voice__img" aria-hidden="true"></span>
          <div><p class="cru-voice__name cru-placeholder--klein">[NAME]</p><p class="cru-voice__role cru-placeholder--klein">[FUNKTION], [FIRMA]</p></div>
        </figcaption>
      </div>
    </figure>
    <VideoFrame format="portrait" label="Kundenstimme als Film" />
  </div>
</section>
