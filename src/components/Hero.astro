    <div class="cru-video__poster" style="place-items:start end;padding:96px var(--page-margin, var(--margin-desktop))">
      <span class="cru-label">[SHOWREEL_LOOP_15S]</span>
    </div>
    <div class="cru-video__shade"></div>
  </div>
  <div class="cru-hero__content">
    <h1 class="cru-hero__claim"><span>Documentary</span><span>First.</span><span class="is-light">Storytelling Always.</span></h1>
    <div class="cru-hero__bar">
      <p class="cru-hero__sub">Dokumentarfilme und Branded Documentaries aus der Zentralschweiz.</p>
    </div>
