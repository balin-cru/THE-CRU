---
// Vollbild-Player: wird von jedem Film-Rahmen geöffnet und zeigt den ganzen Film mit Ton.
---
<div class="cru-player" role="dialog" aria-modal="true" aria-label="Film im Vollbild" hidden data-player>
  <button class="cru-iconbtn cru-player__close" type="button" aria-label="Vollbild schliessen" data-player-close>
    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2.5 1L8 6.5 13.5 1 15 2.5 9.5 8l5.5 5.5-1.5 1.5L8 9.5 2.5 15 1 13.5 6.5 8 1 2.5z"/></svg>
  </button>
  <div class="cru-player__frame" data-player-frame></div>
</div>

<script>
  // Loops laufen nur, solange sie im Bild sind: das Vimeo-Fenster wird erst dann geladen
  // und beim Verlassen wieder entfernt. So läuft nie mehr als nötig.
  const sparsam = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const filme = document.querySelectorAll<HTMLElement>("[data-film]");

  const laden = (film: HTMLElement) => {
    const frame = film.querySelector<HTMLIFrameElement>(".cru-video__loop");
    if (!frame || film.hasAttribute("data-pausiert")) return;
    const src = frame.dataset.src;
    if (src && frame.src !== src) frame.src = src;
  };
  const entladen = (film: HTMLElement) => {
    const frame = film.querySelector<HTMLIFrameElement>(".cru-video__loop");
    if (frame && frame.src !== "about:blank") frame.src = "about:blank";
    film.classList.remove("is-bereit");
  };

  if (!sparsam && filme.length) {
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => (e.isIntersecting ? laden : entladen)(e.target as HTMLElement)),
      { rootMargin: "100px" },
    );
    filme.forEach((f) => io.observe(f));
  }

  // Der Vimeo-Player meldet sich, sobald er läuft. Erst dann wird das Fenster sichtbar;
  // ist Vimeo blockiert, bleibt das dunkle Filmfenster stehen statt einer weissen Fläche.
  window.addEventListener("message", (e) => {
    if (e.origin !== "https://player.vimeo.com") return;
    filme.forEach((film) => {
      const frame = film.querySelector<HTMLIFrameElement>(".cru-video__loop");
      if (frame && frame.contentWindow === e.source) film.classList.add("is-bereit");
    });
  });

  // Pause-Knopf: hält den Loop an und lässt ihn wieder starten (WCAG 2.2.2).
  // Der Knopf liegt auf dem Film oder, mit Kennung, daneben in der Leiste.
  document.querySelectorAll<HTMLButtonElement>("[data-film-pause]").forEach((knopf) => {
    const film = knopf.dataset.filmPause
      ? document.getElementById(knopf.dataset.filmPause)
      : knopf.closest<HTMLElement>("[data-film]");
    if (film) knopf.addEventListener("click", () => {
      const pausiert = film.toggleAttribute("data-pausiert");
      knopf.setAttribute("aria-label", `${pausiert ? "Loop starten" : "Loop anhalten"}: ${film.dataset.titel ?? ""}`);
      knopf.innerHTML = pausiert
        ? '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2l10 6-10 6z"/></svg>'
        : '<svg viewBox="0 0 16 16" aria-hidden="true"><rect x="3" y="2" width="3.5" height="12"/><rect x="9.5" y="2" width="3.5" height="12"/></svg>';
      pausiert ? entladen(film) : laden(film);
    });
  });


  // Vollbild: der ganze Film mit Ton und Vimeo-Steuerung.
  const player = document.querySelector<HTMLElement>("[data-player]");
  const frame = document.querySelector<HTMLElement>("[data-player-frame]");
  const schliessen = document.querySelector<HTMLButtonElement>("[data-player-close]");
  let ausloeser: HTMLElement | null = null;

  const oeffnen = (film: HTMLElement, von: HTMLElement) => {
    if (!player || !frame) return;
    ausloeser = von;
    frame.innerHTML = `<iframe src="${film.dataset.voll}" title="${film.dataset.titel ?? "Film"}" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>`;
    player.hidden = false;
    document.body.style.overflow = "hidden";
    schliessen?.focus();
  };
  const zu = () => {
    if (!player || !frame) return;
    frame.innerHTML = "";
    player.hidden = true;
    document.body.style.overflow = "";
    ausloeser?.focus();
  };

  filme.forEach((film) => {
    film.querySelector<HTMLButtonElement>("[data-film-voll]")?.addEventListener("click", (e) => {
      e.preventDefault();
      e.stopPropagation();
      oeffnen(film, e.currentTarget as HTMLElement);
    });
  });
  document.querySelectorAll<HTMLElement>("[data-film-oeffnet]").forEach((knopf) => {
    const film = document.getElementById(knopf.dataset.filmOeffnet ?? "");
    if (film) knopf.addEventListener("click", () => oeffnen(film, knopf));
  });
  schliessen?.addEventListener("click", zu);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && player && !player.hidden) zu();
  });
</script>
