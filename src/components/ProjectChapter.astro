---
import VideoFrame from "./VideoFrame.astro";
import type { Projekt } from "../content/projekte";

interface Props { projekt: Projekt }
const { projekt } = Astro.props;
const filmId = `film-${projekt.slug}`;
// Eigene Projektseiten folgen. Bis dahin öffnet ein Klick den ganzen Film im Vollbild.
---
<article class="cru-chapter">
  <div class="cru-chapter__link">
    <div class="cru-chapter__stage">
      <VideoFrame id={filmId} vimeo={projekt.vimeo} format="scope" controls="pause" label={`${projekt.titel}, ${projekt.subline}`} status={projekt.titel} />
      <div class="cru-sucher" aria-hidden="true">
        <span class="cru-sucher__ecke"></span><span class="cru-sucher__ecke"></span><span class="cru-sucher__ecke"></span><span class="cru-sucher__ecke"></span>
        <span class="cru-sucher__info cru-sucher__info--oben-rechts">2.39:1</span>
      </div>
      <div class="cru-chapter__over">
        <h3 class="cru-chapter__title">
          <button type="button" data-film-oeffnet={filmId} aria-label={`${projekt.titel}, ${projekt.subline} Film ansehen`}>{projekt.titel}</button>
        </h3>
        <div>
          <p class="cru-chapter__subline">{projekt.subline}</p>
          <ul class="cru-tags cru-label">{projekt.tags.map((t) => <li>{t}</li>)}</ul>
        </div>
      </div>
    </div>
  </div>
</article>
