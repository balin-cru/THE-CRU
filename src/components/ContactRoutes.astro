---
import { company, bookingUrl } from "../site";
// Zwei Kontaktwege: Dokumentarfilm zuerst, dann Commercial und Social.
const mail = (subject: string) => `mailto:${company.email}?subject=${encodeURIComponent(subject)}`;
---
<section class="cru-section" id="kontakt" aria-label="Kontaktwege">
  <div class="cru-routes">
    <div class="cru-route cru-route--doc">
      <h2 class="cru-route__title">LET’S FIND YOUR STORY</h2>
      <p class="cru-label cru-route__meta">Dokumentarfilm und Branded Documentary</p>
      <p class="cru-route__text">Du hast eine Geschichte, die erzählt werden will? Wir hören zu.</p>
      <div>
        <a class="cru-btn cru-btn--primary" href={bookingUrl || mail("Dokumentarfilm")}><span class="cru-rec" aria-hidden="true"></span>Termin vereinbaren</a>
      </div>
      <div class="cru-route__contact"><a class="cru-link" href={`mailto:${company.email}`}>{company.email}</a><a class="cru-link" href={company.phoneHref}>{company.phone}</a></div>
    </div>
    <div class="cru-route">
      <h2 class="cru-route__title">LET’S MAKE SOMETHING</h2>
      <p class="cru-label cru-route__meta">Commercial und Social</p>
      <p class="cru-route__text">Kampagne, Reels oder Aftermovie. Sag uns, was Du brauchst.</p>
      <div>
        <a class="cru-btn cru-btn--secondary" href={mail("Projektanfrage")}><span class="cru-rec" aria-hidden="true"></span>Projekt anfragen</a>
      </div>
      <div class="cru-route__contact"><a class="cru-link" href={`mailto:${company.email}`}>{company.email}</a><a class="cru-link" href={company.phoneHref}>{company.phone}</a></div>
    </div>
  </div>
</section>
