---
import "../styles/seite.css";
import Logo from "../components/Logo.astro";
import Pfeil from "../components/Pfeil.astro";
import { adobeFontsKit, company, platzhalterVimeo, url } from "../site";

interface Props {
  title: string;
  description: string;
  /** Aktiver Menüpunkt: projekte, leistungen, ueber-uns */
  aktiv?: string;
  noindex?: boolean;
  /** Hat die Seite einen eigenen Kontaktblock? Sonst führt «Kontakt» zur Startseite. */
  kontaktHier?: boolean;
}
const { title, description, aktiv, noindex = false, kontaktHier = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === "THE CRU" ? "THE CRU – Story First. Emotion Always." : `${title} – THE CRU`;
const kontakt = kontaktHier ? "#kontakt" : url("#kontakt");
const nav = [
  { id: "projekte", name: "Projekte" },
  { id: "leistungen", name: "Leistungen" },
  { id: "ueber-uns", name: "Über uns" },
];
---
<!doctype html>
<html lang="de-CH">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_CH" />
    <meta property="og:site_name" content="THE CRU" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#212322" />
    <link rel="icon" type="image/svg+xml" href={url("logos/logo-creme.svg")} />
    {adobeFontsKit && (
      <>
        <link rel="preconnect" href="https://use.typekit.net" crossorigin />
        <link rel="stylesheet" href={`https://use.typekit.net/${adobeFontsKit}.css`} />
      </>
    )}
  </head>
  <body data-vimeo={platzhalterVimeo}>
    <a class="pille pille--creme skip" href="#inhalt">Zum Inhalt</a>
    <header class="kopf" id="kopf">
      <a class="kopf__logo" href={url()} aria-label="THE CRU, zur Startseite"><Logo /></a>
      <nav aria-label="Hauptnavigation">
        <ul>
          {nav.map((n) => <li><a href={url(n.id + "/")} aria-current={aktiv === n.id ? "page" : undefined}>{n.name}</a></li>)}
        </ul>
      </nav>
      <div class="kopf__aktionen">
        <a class="pille pille--creme kopf__kontakt" href={kontakt}><span class="rec" aria-hidden="true"></span>Kontakt</a>
        <button class="pille pille--glas kopf__menue" type="button" id="menue-auf" aria-expanded="false" aria-controls="menue">Menü</button>
      </div>
    </header>

    <nav class="menue" id="menue" aria-label="Menü">
      <ul>
        {nav.map((n) => <li><a href={url(n.id + "/")}>{n.name}</a></li>)}
        <li><a href={kontakt}>Kontakt</a></li>
      </ul>
      <p>{company.email}<br />{company.phone}</p>
    </nav>

    <main id="inhalt">
      <slot />
    </main>

    <footer class="block ton-nacht fuss" data-ton="nacht">
      <p class="fuss__claim" aria-label="Story First. Emotion Always."><span>Story First.</span><span class="duenn">Emotion Always.</span></p>
      <div class="fuss__raster">
        <div class="kopf__logo"><Logo /></div>
        <address>{company.name}<br />{company.street}<br />{company.zip} {company.city}</address>
        <div><a href={url("projekte/")}>Projekte</a><br /><a href={url("leistungen/")}>Leistungen</a><br /><a href={url("ueber-uns/")}>Über uns</a><br /><a href={kontakt}>Kontakt</a></div>
        <div><a href={`mailto:${company.email}`}>{company.email}</a><br /><a href={company.phoneHref}>{company.phone}</a><br /><a href={company.instagram} target="_blank" rel="noopener">Instagram</a></div>
      </div>
      <div class="fuss__recht leise"><span>UID {company.uid}</span><a href={url("impressum/")}>Impressum</a><a href={url("datenschutz/")}>Datenschutz</a><a href={url("agb/")}>AGB</a></div>
    </footer>

    <div class="vorschau" id="vorschau" aria-hidden="true"><div class="film t-doc" id="vorschau-film"><div class="film__vignette"></div></div></div>

    <dialog class="vollbild" id="vollbild" aria-labelledby="vollbild-titel">
      <div class="vollbild__kopf"><strong id="vollbild-titel">Film</strong><button class="rund" type="button" id="vollbild-zu" aria-label="Vollbild schliessen"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2.5 1L8 6.5 13.5 1 15 2.5 9.5 8l5.5 5.5-1.5 1.5L8 9.5 2.5 15 1 13.5 6.5 8 1 2.5z" /></svg></button></div>
      <div class="vollbild__buehne"><div class="film t-reel" id="vollbild-film"><div class="film__vignette"></div></div></div>
      <div class="vollbild__fuss"><span class="leise">Escape oder Schliessen führt zurück.</span><a class="pille pille--leise" id="vollbild-projekt" href={url("projekte/")}>Zum Projekt <Pfeil /></a></div>
    </dialog>

    <dialog class="termin" id="termin" aria-labelledby="termin-titel">
      <div class="termin__kopf">
        <div><p class="termin__art">Termin buchen</p><p class="termin__name" id="termin-titel">Balin Imfeld</p></div>
        <button class="rund" type="button" id="termin-zu" aria-label="Fenster schliessen"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2.5 1L8 6.5 13.5 1 15 2.5 9.5 8l5.5 5.5-1.5 1.5L8 9.5 2.5 15 1 13.5 6.5 8 1 2.5z" /></svg></button>
      </div>
      <div class="termin__inhalt" id="termin-inhalt">
        <a class="termin__notlink" id="termin-notlink" href="https://calendar.app.google/fApaZb7ZBqKw43t26" target="_blank" rel="noopener">Lädt nicht? Buchungsseite in neuem Tab öffnen</a>
      </div>
    </dialog>

    <div class="zeiger" id="zeiger" aria-hidden="true"></div>
    <script src="../scripts/seite.js"></script>
  </body>
</html>
